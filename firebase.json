{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/caisse",
        "destination": "/app.html"
      },
      {
        "source": "/caisse/**",
        "destination": "/app.html"
      },
      {
        "source": "/manager",
        "destination": "/app.html"
      },
      {
        "source": "/manager/**",
        "destination": "/app.html"
      }
    ]
  }
}